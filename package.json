{
  "name": "magic-courier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-magic-courier \"vitest run tests/firestore.rules.test.ts\"",
    "functions:build": "tsc -p functions/tsconfig.json",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-magic-courier",
    "seed": "node scripts/seed.mjs",
    "test:firebase": "firebase emulators:exec --only firestore,auth,functions --project demo-magic-courier \"npm run seed && vitest run tests/firebase.integration.test.ts tests/firestore.rules.test.ts\""
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.30.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
