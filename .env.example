# local: persistent server-side JSON + HttpOnly session; development only.
# firebase: Firebase Auth custom token + Firestore + callable Functions.
NEXT_PUBLIC_BACKEND=local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-magic-courier
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_USE_EMULATORS=false
FIREBASE_PROJECT_ID=demo-magic-courier
DAILY_RANKING_CAP=25
# Local server only. Generate 32+ random bytes; mandatory with local production opt-in.
SESSION_SECRET=
ALLOW_LOCAL_BACKEND=false
# Local E2E isolated data path (optional)
LOCAL_DATA_PATH=.local-data/state.json
