# Firebase 설정 (STEP 11). 이 파일을 .env.local 로 복사하고 값을 채운다.
# .env.local 은 git 에 올리지 않는다. 값이 비어 있으면 앱은 localStorage 로 돈다.
#
# 값 찾는 곳: Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → 웹 앱 → SDK 설정 및 구성
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check → reCAPTCHA v3 사이트 키 (콘솔 → App Check → 앱 등록)
VITE_RECAPTCHA_SITE_KEY=

# Cloud Functions 리전. 서울 리전을 쓴다.
VITE_FIREBASE_REGION=asia-northeast3

# 1 이면 로컬 에뮬레이터(firebase emulators:start)에 붙는다
VITE_USE_EMULATOR=0
